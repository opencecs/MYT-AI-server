# 根 camdemo/ 是开发调试残留目录，一律忽略；仅保留 embed 源目录
# （逐段 unignore：父目录被忽略时，先恢复目录本身，子项才能生效）
camdemo/*
!camdemo/ffmpeg_minimal
!camdemo/windows_pusher
camdemo/ffmpeg_minimal/*
!camdemo/ffmpeg_minimal/bin/
camdemo/windows_pusher/*
!camdemo/windows_pusher/Release_native/
MYT/camdemo/*
!MYT/camdemo/ffmpeg_minimal/
!MYT/camdemo/windows_pusher/
MYT/camdemo/ffmpeg_minimal/*
!MYT/camdemo/ffmpeg_minimal/bin/
MYT/camdemo/windows_pusher/*
!MYT/camdemo/windows_pusher/Release_native/
# ffmpeg_minimal/lib/ 静态库内嵌编译机路径，永不入库
MYT/camdemo/ffmpeg_minimal/lib/
!MYT/camdemo/ffmpeg_minimal/bin/ffmpeg.exe
!MYT/camdemo/windows_pusher/Release_native/WindowsPusher.exe
