  "guide": {
    "title": "流媒体使用说明",
    "forwardTitle": "转发流（OBS）",
    "forwardSteps": {
      "1": "打开 OBS，进入 设置 → 直播，服务选择 自定义。",
      "2": "将页面顶部展示的 WebRTC 推流地址或 RTMP 推流地址填入「服务器」栏（点击地址可一键复制）。",
      "3": "在「推流码」栏填入自定义的推流码，点击确定后在 OBS 中点击 开始直播。",
      "4": "回到本页面，点击 新建流，输入与推流码相同的名称后确认。命名一致后该条目将保留在列表中，推流状态实时可见。",
      "5": "列表中该条目状态变为 活跃 后，点击 分发 按钮，选择目标设备和云机。",
      "6": "在云机上打开 相机 即可查看对应画面。"
    },
    "p2pTitle": "点对点（P2P / OBS）",
    "p2pSteps": {
      "1": "切换到 点对点 标签，点击 添加P2P流。",
      "2": "在弹窗中选择 设备 和 云机，确认后列表会显示对应的 监听地址（点击可一键复制）。",
      "3": "打开 OBS，进入 设置 → 直播，服务选择 自定义，将监听地址填入「服务器」栏，无需填写推流码。",
      "4": "在 OBS 中点击 开始直播，然后点击列表中的 启动P2P 按钮。",
      "5": "在对应云机上打开 相机 即可查看实时画面。"
    },
    "cameraTitle": "PC 摄像头",
    "cameraSteps": {
      "1": "切换到 PC摄像头 标签，点击 添加摄像头推流。",
      "2": "在弹窗中选择 设备、云机 以及可用的 摄像头，配置分辨率与码率后保存。",
      "3": "在列表中点击 启动 按钮，右侧预览区会自动展示实时画面。",
      "4": "在对应云机上打开 相机 即可查看推流画面。"
    }
  },
