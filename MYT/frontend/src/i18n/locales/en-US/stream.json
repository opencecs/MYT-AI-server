  "guide": {
    "title": "Streaming Guide",
    "forwardTitle": "Forward Stream (OBS)",
    "forwardSteps": {
      "1": "Open OBS, go to Settings → Stream, and set Service to Custom.",
      "2": "Paste the WebRTC or RTMP push URL shown at the top into \"Server\" (click the URL to copy).",
      "3": "Enter a custom stream key, click OK, then click Start Streaming in OBS.",
      "4": "Return here, click New Stream, and enter the same name as your stream key. With matching names the entry stays in the list with live status.",
      "5": "Once the entry shows Active, click Distribute and select the target device and machine.",
      "6": "Open the Camera app inside the cloud machine to view the stream."
    },
    "p2pTitle": "Peer-to-Peer (P2P / OBS)",
    "p2pSteps": {
      "1": "Switch to the P2P tab and click Add P2P Stream.",
      "2": "Select Device and Machine in the dialog. The list will show the Listen Address (click to copy).",
      "3": "Open OBS, go to Settings → Stream, set Service to Custom, and paste the listen address into \"Server\". Leave the stream key empty.",
      "4": "Click Start Streaming in OBS, then click the Start P2P button in the list.",
      "5": "Open the Camera app inside the cloud machine to view the feed."
    },
    "cameraTitle": "PC Camera",
    "cameraSteps": {
      "1": "Switch to the PC Camera tab and click Add Camera Stream.",
      "2": "Select Device, Machine, and an available Camera in the dialog, then configure resolution and bitrate.",
      "3": "Click Start in the list. The right preview area shows the live feed automatically.",
      "4": "Open the Camera app inside the cloud machine to view the feed."
    }
  },
